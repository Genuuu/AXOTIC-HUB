rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    
    // Check if the request is authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Retrieve the requesting user's document from the 'users' collection
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Check if the user is an admin
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    // ==========================================
    // PUBLIC CONFIGURATION & SETTINGS
    // ==========================================

    // Public Landing Page configuration
    match /landing/{docId} {
      allow read: if true; // Publicly viewable by anyone on the landing page
      allow write: if isAdmin();
    }
    
    // App configuration settings
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Connection test document
    match /test/{docId} {
      allow read, write: if isAuthenticated();
    }

    // ==========================================
    // USERS & ACCESS CONTROL
    // ==========================================

    // Users collection
    match /users/{userId} {
      // Any authenticated user can read other users (for the roster)
      allow read: if isAuthenticated();
      
      // Users can create their own profile during initial signup/linking
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // Users can update their own profile, or admins can update any profile (e.g. promoting roles)
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // Only admins can delete members from the roster
      allow delete: if isAdmin();
    }

    // ==========================================
    // INVENTORY & CATEGORIES
    // ==========================================

    match /inventory/{docId} {
      // Authenticated users can view and edit inventory (for checking out parts)
      allow read, write: if isAuthenticated();
    }
    
    match /categories/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin(); // Only admins can add/remove inventory categories
    }

    // ==========================================
    // PROJECTS & HARDWARE
    // ==========================================

    match /projects/{projectId} {
      // Team members can view and manage projects
      allow read, write: if isAuthenticated(); 
      
      match /hardware/{hwId} {
        allow read, write: if isAuthenticated();
      }
      
      match /logs/{logId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ==========================================
    // COMPETITIONS
    // ==========================================

    match /competitions/{compId} {
      // Team members can view and manage competitions
      allow read, write: if isAuthenticated();
    }

    // ==========================================
    // IDEAS BOARD
    // ==========================================

    match /ideas/{ideaId} {
      allow read, write: if isAuthenticated();
    }

    // ==========================================
    // NOTIFICATIONS & LOGGING
    // ==========================================

    match /notifications/{notifId} {
      allow read, write: if isAuthenticated();
    }

    match /admin_logs/{logId} {
      allow read: if isAdmin();
      // Any authenticated action might trigger an admin log
      allow create: if isAuthenticated(); 
      // Logs are immutable and should never be edited or deleted
      allow update, delete: if false; 
    }
    
    // Firebase Extensions Mail collection (if used for sending emails)
    match /mail/{mailId} {
      allow create: if isAdmin();
      allow read, update, delete: if false;
    }
  }
}
