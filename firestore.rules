rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // ==========================================
    // HELPER FUNCTIONS & ROLE CHECK
    // ==========================================
    
    // Check if the request is authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Retrieve the requesting user's document from the 'users' collection
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Check if the user is an admin or bootstrapped admin
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == "genukakisara@gmail.com" && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin')
      );
    }

    // ==========================================
    // PUBLIC CONFIGURATION & LANDING
    // ==========================================

    // Public Landing Page configuration
    match /landing/{docId} {
      allow read: if true; // Publicly viewable by prospective applicants & sponsors
      allow write: if isAdmin();
    }
    
    // App configuration & workspace settings
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Team members can record general fund ledger syncs
    }
    
    // Connection diagnostics test document
    match /test/{docId} {
      allow read, write: if isAuthenticated();
    }

    // ==========================================
    // USERS & ROSTER ACCESS CONTROL
    // ==========================================

    match /users/{userId} {
      // Authenticated team members can browse roster directory
      allow read: if isAuthenticated();
      
      // Users can register their initial profile; admins can provision members
      allow create: if isAuthenticated() && (
        request.auth.uid == userId || isAdmin()
      );
      
      // Users can update their own profile, but non-admins cannot self-promote to admin
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == userId && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        ))
      );
      
      // Only admins can remove members from the roster
      allow delete: if isAdmin();
    }

    // ==========================================
    // INVENTORY STOCKROOM & CATEGORIES
    // ==========================================

    match /inventory/{docId} {
      // Team members can view, add, and adjust stockroom component quantities
      allow read, write: if isAuthenticated();
    }
    
    match /categories/{docId} {
      // Team members can view categories; members and admins can organize categories
      allow read, write: if isAuthenticated();
    }

    // ==========================================
    // PROJECTS, LOGS & ALLOCATED HARDWARE
    // ==========================================

    match /projects/{projectId} {
      // Team members can collaborate on active builds
      allow read, write: if isAuthenticated(); 
      
      match /hardware/{hwId} {
        allow read, write: if isAuthenticated();
      }
      
      match /logs/{logId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ==========================================
    // COMPETITIONS
    // ==========================================

    match /competitions/{compId} {
      // Team members can register and manage competition timelines
      allow read, write: if isAuthenticated();
    }

    // ==========================================
    // BRAINSTORMING & IDEAS BOARD
    // ==========================================

    match /ideas/{ideaId} {
      // Team members can propose ideas, upvote, and promote to builds
      allow read, write: if isAuthenticated();
    }

    // ==========================================
    // NOTIFICATIONS & AUDIT LOGS
    // ==========================================

    match /notifications/{notifId} {
      allow read, write: if isAuthenticated();
    }

    match /admin_logs/{logId} {
      allow read: if isAdmin();
      // Authenticated team actions record audit logs
      allow create: if isAuthenticated(); 
      // Logs are immutable for security auditing
      allow update, delete: if false; 
    }
    
    // Outbound email triggers
    match /mail/{mailId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false;
    }
  }
}
